---
/* Página /contacto: dirección con mapa, horarios, teléfono / WhatsApp / mail, redes y formulario.
   Los datos salen de lib/contacto.js. El mapa de Google se carga recién cuando la persona
   baja hasta él (loading="lazy"), y solo en esta página: el resto del sitio no se ve afectado. */
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import "../styles/contact.css";
import { CONTACT, mapsEmbed, mapsLink } from "../lib/contacto";
import { whatsappHref } from "../lib/hero";

const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const waHref = whatsappHref(waNumber, CONTACT.whatsappMessage);
const hasWa = waHref.startsWith("http");
const hasForm = Boolean(import.meta.env.PUBLIC_WEB3FORMS_KEY);
const social = [
  CONTACT.social.facebook && { label: "Facebook", href: CONTACT.social.facebook },
  CONTACT.social.instagram && { label: "Instagram", href: CONTACT.social.instagram },
].filter(Boolean);
---

<Layout
  title="Contacto — Mutual Coyspu Hogar"
  description="Dónde encontrarnos, horarios de atención, teléfono, WhatsApp y mail de Mutual Coyspu Hogar."
>
  <section class="contact">
    <div class="container">
      <header class="contact__head">
        <span class="eyebrow eyebrow--dark">Contacto</span>
        <h1>Estamos para ayudarte</h1>
        <p>Visitanos, llamanos o escribinos: te respondemos a la brevedad.</p>
      </header>

      <div class="contact__grid">
        <div class="contact__cards">
          <article class="ccard">
            <h2><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Dirección</h2>
            <p>{CONTACT.address.street}<br />{CONTACT.address.city}</p>
            <a class="btn btn--dark" href={mapsLink(CONTACT.address.mapQuery)} target="_blank" rel="noopener noreferrer">
              Cómo llegar
              <svg class="icon" aria-hidden="true" style="width:18px;height:18px"><use href="#i-arrow" /></svg>
            </a>
          </article>

          <article class="ccard">
            <h2><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>Horarios</h2>
            <dl class="hours">
              {CONTACT.hours.map((h) => (
                <div>
                  <dt>{h.days}</dt>
                  <dd>{h.time}</dd>
                </div>
              ))}
            </dl>
          </article>

          <article class="ccard">
            <h2><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>Escribinos o llamanos</h2>
            <ul class="clist">
              {hasWa && (
                <li>
                  <a href={waHref} target="_blank" rel="noopener noreferrer">
                    <i class="fa-brands fa-whatsapp fa-lg"></i>
                    <span><strong>WhatsApp</strong><small>Enviar Mensaje</small></span>
                  </a>
                </li>
              )}
              <li>
                <a href={`tel:${CONTACT.phone.tel}`}>
                  <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
                  <span><strong>{CONTACT.phone.label}</strong><small>Llamar</small></span>
                </a>
              </li>
              <li>
                <a href={`mailto:${CONTACT.email}`}>
                  <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
                  <span><strong>{CONTACT.email}</strong><small>Enviar un mail</small></span>
                </a>
              </li>
            </ul>
          </article>

          {social.length > 0 && (
            <article class="ccard">
              <h2><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="18" cy="5.5" r="2.7"/><circle cx="6" cy="12" r="2.7"/><circle cx="18" cy="18.5" r="2.7"/><path d="M8.4 10.7l7.2-3.9M8.4 13.3l7.2 3.9"/></svg>Seguinos</h2>
              <ul class="social">
                {social.map((s) => <li><a class="social__link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
              </ul>
            </article>
          )}
        </div>

        <div class="contact__map">
          <iframe
            title={`Mapa: ${CONTACT.address.street}, ${CONTACT.address.city}`}
            src={mapsEmbed(CONTACT.address.mapQuery)}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      {hasForm && (
        <section class="contact__form" aria-labelledby="form-title">
          <div>
            <h2 id="form-title">Dejanos tu consulta</h2>
            <p>Completá el formulario y te respondemos por teléfono o mail.</p>
          </div>
          <ContactForm />
        </section>
      )}
    </div>
  </section>
</Layout>
