---
/* Tarjeta de producto. Toda la tarjeta es clicable: el botón del título lleva
   los datos del producto en `data-product` y ProductModal.astro los lee. */
   import { categoryMeta } from "../lib/sanity";

/* `product` es lo que devuelve PRODUCT_FIELDS en lib/sanity.js:
   { name, code, brand, badge, oldPrice, price, installments, description,
     features, attributes, warranty, colors, image, category } */
const { product, filter } = Astro.props;   // `filter` (opcional): datos para los filtros de la categoría
const {
  name, code, brand, badge, oldPrice, price, installments, description, image, category, warranty,
} = product;

// Colores: se descartan referencias rotas y se valida el código hexadecimal
const safeHex = (h) => {
  const v = String(h ?? "").trim().replace(/^#?/, "#");
  return /^#[0-9a-f]{3,8}$/i.test(v) ? v : "#cccccc";
};
const colors = (product.colors ?? [])
  .filter((c) => c && c.name)
  .map((c) => ({ name: c.name, hex: safeHex(c.hex) }));

// Lista del modal: características + atributos (excepto "Color", que ya van como círculos) + garantía
const specs = [
  ...(product.features ?? []),
  ...(product.attributes ?? [])
    .filter((a) => a && a.key && a.value && a.key.trim().toLowerCase() !== "color")
    .map((a) => `${a.key}: ${a.value}`),
  ...(warranty ? [`Garantía: ${warranty} ${warranty === 1 ? "mes" : "meses"}`] : []),
];

const money = new Intl.NumberFormat("es-AR", {
  style: "currency",
  currency: "ARS",
  maximumFractionDigits: 0,
});
const fmt = (n) => money.format(n).replace(/ /g, " ");

// El icono y el tono vienen del departamento (el padre, si es una subcategoría)
const meta = categoryMeta(category?.parentSlug ?? category?.slug);
const hasDiscount = typeof oldPrice === "number" && oldPrice > price;
const off = hasDiscount ? Math.round((1 - price / oldPrice) * 100) : 0;
const hasInstallments = installments > 1;
const perInstallment = hasInstallments ? fmt(Math.round(price / installments)) : "";
// Todas las imágenes del producto (si no vino la lista, se usa solo la primera).
// fit=max: Sanity solo reduce la imagen para que quepa, sin recortarla.
const urls = (product.images?.length ? product.images : image ? [image] : []).filter(Boolean);
const imageSrc = urls[0] ? `${urls[0]}?w=800&h=800&fit=max&auto=format` : undefined;
const images = urls.map((u) => ({
  src: `${u}?w=1000&h=1000&fit=max&auto=format`,   // imagen grande del modal
  thumb: `${u}?w=160&h=160&fit=max&auto=format`,   // miniatura
}));

const badges = [];
if (badge) badges.push({ label: badge });
if (hasDiscount && off > 0) badges.push({ label: `-${off}%`, off: true });

// Datos que consume el modal (ya formateados)
const payload = {
  name,
  code: code ?? "",
  brand: brand ?? "",
  category: category?.title ?? "",
  tone: meta.tone,
  icon: meta.icon,
  images,
  badges,
  oldPrice: hasDiscount ? fmt(oldPrice) : "",
  price: fmt(price),
  installments: hasInstallments ? installments : 0,
  perInstallment,
  colors,
  description: description ?? "",
  specs,
};
---

<article class="product-card" data-f={filter ? JSON.stringify(filter) : undefined}>
  <div class={`product-card__media ${meta.tone}`}>
    {badges.length > 0 && (
      <div class="badges">
        {badges.map((b) => <span class={b.off ? "badge badge--off" : "badge"}>{b.label}</span>)}
      </div>
    )}
    {imageSrc ? (
      <img src={imageSrc} alt="" loading="lazy" decoding="async" />
    ) : (
      <svg class="icon" aria-hidden="true"><use href={`#${meta.icon}`} /></svg>
    )}
  </div>

  <div class="product-card__body">
    {category && <span class="product-card__cat">{category.title}</span>}

    <h3 class="product-card__title">
      <button type="button" class="product-card__open" data-product={JSON.stringify(payload)}>
        {name}
      </button>
    </h3>

    {colors.length > 0 && (
      <ul class="swatches" role="img" aria-label={`Colores disponibles: ${colors.map((c) => c.name).join(", ")}`}>
        {colors.map((c) => <li class="swatch" style={`--sw:${c.hex}`} title={c.name} />)}
      </ul>
    )}

    <div class="price">
      {hasDiscount && (
        <span class="price__old"><span class="sr-only">Precio anterior </span>{fmt(oldPrice)}</span>
      )}
      <span class="price__now"><span class="sr-only">{hasDiscount ? "Precio promoción " : "Precio "}</span>{fmt(price)}</span>
    </div>

    {hasInstallments && (
      <p class="installments">
        <strong>{installments} cuotas</strong> sin interés de <strong>{perInstallment}</strong>
        <br>
        <span>con <strong>Tarjeta Coyspu</strong></span>
      </p>
    )}
  </div>
</article>