---
/* Tarjeta de producto. Toda la tarjeta es clicable: el enlace del título lleva a la
   página del producto (/productos/[slug]) y se "estira" sobre toda la tarjeta. */
   import { buildProductView } from "../lib/products";

/* `product` es lo que devuelve PRODUCT_FIELDS en lib/sanity.js */
const { product, filter } = Astro.props;   // `filter` (opcional): datos para los filtros de la categoría
const v = buildProductView(product);
const { name, category, colors, badges, oldPrice, price, installments, perInstallment, hasDiscount, outOfStock } = v;
const imageSrc = v.images[0]?.card;
const href = product.slug ? v.url : undefined;
---

<article class:list={["product-card", outOfStock && "product-card--out"]} data-f={filter ? JSON.stringify(filter) : undefined}>
  <div class={`product-card__media ${v.tone}`}>
    {badges.length > 0 && (
      <div class="badges">
        {badges.map((b) => <span class:list={["badge", b.off && "badge--off", b.out && "badge--out"]}>{b.label}</span>)}
      </div>
    )}
    {imageSrc ? (
      <img src={imageSrc} alt="" loading="lazy" decoding="async" />
    ) : (
      <svg class="icon" aria-hidden="true"><use href={`#${v.icon}`} /></svg>
    )}
  </div>

  <div class="product-card__body">
    {category && <span class="product-card__cat">{category.title}</span>}

    <h3 class="product-card__title">
      {href ? <a class="product-card__open" href={href}>{name}</a> : <span>{name}</span>}
    </h3>

    {colors.length > 0 && (
      <ul class="swatches" role="img" aria-label={`Colores disponibles: ${colors.map((c) => c.name).join(", ")}`}>
        {colors.map((c) => <li class="swatch" style={`--sw:${c.hex}`} title={c.name} />)}
      </ul>
    )}

    <div class="price">
      {hasDiscount && (
        <span class="price__old"><span class="sr-only">Precio anterior </span>{oldPrice}</span>
      )}
      <span class="price__now"><span class="sr-only">{hasDiscount ? "Precio promoción " : "Precio "}</span>{price}</span>
    </div>

    {installments > 0 && (
      <p class="installments">
        {installments} cuotas sin interés de <strong>{perInstallment}</strong>
      </p>
    )}
  </div>
</article>