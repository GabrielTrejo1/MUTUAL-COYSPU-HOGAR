---
/* Pie de página. Los datos de contacto son de ejemplo: reemplazar por los reales. */
const year = new Date().getFullYear();

const explore = [
  { href: "/#catalogo", label: "Catálogo" },
  { href: "/#ofertas", label: "Ofertas" },
  { href: "#", label: "Cómo comprar" },
  { href: "#", label: "Preguntas frecuentes" },
];
const info = [
  { href: "#", label: "Envíos y entregas" },
  { href: "#", label: "Medios de pago" },
  { href: "#", label: "Garantías" },
  { href: "#", label: "Términos y condiciones" },
];
---

<footer class="site-footer" id="contacto">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__about">
        <a href="/" class="brand">
          <span class="brand__mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5v-5h4v5"/></svg>
          </span>
          <span>Mutual Coyspu<small>Hogar</small></span>
        </a>
        <p>Soluciones para el hogar con el respaldo y la cercanía de la mutual.</p>
        <div class="footer__social">
          <a href="#" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8.5V6.9c0-.7.5-1 1.1-1H17V3h-2.6C11.9 3 10.5 4.6 10.5 6.7V8.5H8v3h2.5V21h3.5v-9.5h2.6l.4-3z"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="#" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-whatsapp" /></svg>
          </a>
        </div>
      </div>

      <div>
        <h3>Explorar</h3>
        <ul class="footer__links">
          {explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h3>Información</h3>
        <ul class="footer__links">
          {info.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h3>Contacto</h3>
        <ul class="footer__contact">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            <span>Dirección de la sucursal<br />Ciudad, Provincia</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
            <span>(000) 000-0000</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
            <span>hogar@mutualcoyspu.com</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} Mutual Coyspu Hogar. Todos los derechos reservados.</p>
      <p>Precios y financiación sujetos a cambios sin previo aviso.</p>
    </div>
  </div>
</footer>
